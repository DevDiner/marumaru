# World ID (IDKit v4)
WORLD_ID_MODE=mock            # mock | real  (real = wire the actual IDKit v4 flow)
WORLD_ID_ENV=staging          # staging (World Simulator, works in a browser, no phone) | production (World App, at the event)
WORLD_APP_ID=app_staging_xxx
WORLD_RP_ID=rp_xxx
WORLD_RP_SIGNING_KEY=0x...    # server-side only; from Developer Portal
WORLD_ACTION=marumaru-issue
# Tiered assurance: which World tier is the MINIMUM to issue. BLANK = shopping/pre-qualification —
# accept Orb / Passport / Selfie (the tier is FLAGGED on the passport, not gated). Set to "orb" only
# for the future underwriting / document-transfer action, where one-human uniqueness must be enforced.
# (Selfie Check is Beta and does NOT establish uniqueness — never claim it does; that's why underwriting = orb.)
REQUIRED_HUMAN_LEVEL=         # blank (shopping) | orb (underwriting)

# Attestor (the demo "stub bank" Ed25519 signer). Local dev generates a key per run — fine.
# On Vercel/serverless PIN it so sign+verify survive cold starts (see THE_GUIDE §9):
#   npm run gen:attestor-key   ->  paste the printed value here / into Vercel Production env.
# SECRET — never commit a real value (this file is a template; .env is gitignored).
ATTESTOR_KEY_B64=            # base64 of a PKCS8 Ed25519 PEM; blank = generate at import (local dev)

# Reclaim zkTLS (the self-sovereign / borrower-owned connect method)
RECLAIM_MODE=mock             # mock | real
RECLAIM_APP_ID=0x...
RECLAIM_APP_SECRET=0x...      # server-side only
RECLAIM_PROVIDER_ID=ff4d7afe-4b78-4795-9429-d20df2deaad7   # the provider recipe (default = Reclaim's TEST provider)
RECLAIM_PROVIDER_KEY=                                       # the extractedParameters key to read (e.g. "balance"); reclaim_real_test.mjs prints it for you

# Plaid open banking (the "today's rail" connect method — pairs with the zkTLS path above).
# Sign up at dashboard.plaid.com → API → copy your Sandbox client_id + secret (free, no licensing).
# Absent creds OR PLAID_MODE unset → mock (a Plaid-shaped canned response), so the demo never hard-fails.
# Sandbox test login inside Plaid Link: user_good / pass_good (2FA 1234 if prompted).
PLAID_MODE=mock              # mock | real  (real needs the two keys below)
PLAID_CLIENT_ID=             # from the Plaid dashboard
PLAID_SECRET=                # SANDBOX secret (server-side only; never commit)
PLAID_ENV=sandbox            # sandbox | production

# Chain (ENSv2 Sepolia beta)
SEPOLIA_RPC=https://sepolia.infura.io/v3/xxx    # any Sepolia RPC (Infura/Alchemy/public). REQUIRED for deploy + ONCHAIN_READS.
DEPLOYER_PK=0x...              # funded with Sepolia ETH for gas (payment is MockUSDC, minted below)
PARENT_NAME=marumaru.eth
# ONCHAIN_READS=1 makes the LENDER VIEW resolve marks + consent DIRECTLY from the deployed Sepolia
# contracts (app/ens-client.mjs) — "functional, not hard-coded" for the ENS prize. Leave BLANK/0 for
# the offline store-backed demo. Turn to 1 only AFTER a successful deploy writes demo/addresses.json.
ONCHAIN_READS=              # 1 = read the live chain (needs SEPOLIA_RPC + demo/addresses.json); blank = store
RECLAIM_VERIFIER=             # Reclaim's on-chain verifier addr (blank = off-chain-verified writeMark mode; the demo uses this)
# --- Permissionless on-chain mint (mintWithProofs) — the trustless path. ---
WORLD_ID_ROUTER=0x469449f251692e0779667583026b5a1e99512157   # World ID v3 WorldIDRouter on Ethereum Sepolia (VERIFIED 2026-09-26, docs.world.org); blank = disable on-chain mint
WORLD_EXTERNAL_NULLIFIER=     # precomputed external-nullifier hash for action "marumaru-issue"; blank = 0

# A stale address = the deploy reverts with a cryptic error. This is the #1 event-day failure.
ENS_ETH_REGISTRY=0xdedb92913a25abe1f7bcdd85d8a344a43b398b67           # root .eth registry (re-confirm)
ENS_ETH_REGISTRAR=0x8c2e866b439358c41ae05de9cbe8a00bfefaffca          # .eth registrar, commit->reveal, MockUSDC-paid (re-confirm)
ENS_USER_REGISTRY_IMPL=0x0f99e7ea74903afcb7224d0354fd7428a6f92917      # UserRegistry impl (proxied via factory) (re-confirm)
ENS_RESOLVER_IMPL=0xdce5205a553573ffd47629327dddf36186022ffa          # PermissionedResolver impl (re-confirm)
ENS_VERIFIABLE_FACTORY=0xd2a632d8a8b67c2c4398c255cbd7af8dd7236198      # VerifiableFactory (deploys the proxies) (re-confirm)
ENS_UNIVERSAL_RESOLVER=      # (event) UniversalResolverV2 — from the live table if you need reverse/wildcard
ENS_MOCK_USDC=               # (event) MockUSDC on Sepolia (free-mint; pays registration) — from the live table


POLICY_INCOME_MIN=10000
POLICY_SAVINGS_MIN=50000
POLICY_DSR_MAX_PCT=40         # debt-service-ratio cap: maru.dsr = pass when monthly debt <= 40% of income (INVERTED predicate)
POLICY_INCOME_BAND_MULTIPLES=1,1.5,2   # coarse income-band edges as MULTIPLES of POLICY_INCOME_MIN → maru.income_band = <1x|1-1.5x|1.5-2x|2x+ (a range for pricing/LTV tiers, never the figure)
CREDENTIAL_TTL_DAYS=30
GRANT_TTL_DAYS=14
